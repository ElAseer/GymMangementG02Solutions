
@model int
@addTagHelper *,Microsoft.AspNetCore.Mvc.TageHelpers

@{
    string PageTitle = "Route Academy";
    int Age = 25;
    List<int> numbers = new List<int>() { 1, 2, 3, 4, 5, 6 };

}

<h2>@Model</h2>

<head>
    <title>@PageTitle </title>
</head>

<body>
    <h1>Welcome to Route</h1>
    <h2>@PageTitle</h2>
    <h3>@Age</h3>

    <p> @Age + 1</p>
    <p> @(Age + 1)</p>

    @if(Age >= 18)
        {
            <p>Adult</p>
        }
        else
        {
            <p> Under Age </p>
        }

        <ul> 
            @foreach(int n in numbers)
            {
                <li>numbers : @n</li>
            }

        </ul>

        <a href="/Home/Index"> Test Link</a>
        <a asp-controller="Home" asp-action="Index"> Test Link </a>

        <a asp-controller="Test" asp-action="Hamada" asp-route-id="5"> Test Link </a>

        <!-- Html Comment ==> Render Browser --->
        @*This is Razor comment from Browser*@
    </body>